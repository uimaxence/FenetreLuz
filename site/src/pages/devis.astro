---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Rays from '../components/Rays.astro';
import DevisForm from '../components/DevisForm.astro';
import TrustStrip from '../components/TrustStrip.astro';
import { agencesList } from '../data/agences';
---

<Base
  title="Demande de devis gratuit — Fenêtres, vérandas, portails, volets à Jonzac & Royan | LUZ"
  description="Demandez un devis gratuit à Fenêtres & Vérandas LUZ : fenêtres, portes, vérandas, pergolas, portails, volets, stores en Charente-Maritime. Visite et métré à domicile, réponse sous 48 h ouvrées."
>
  <PageHero
    title="Demande de devis"
    eyebrow="Gratuit et sans engagement"
    lead="Décrivez votre projet en deux minutes. Un conseiller de l’agence la plus proche vous rappelle sous 48 h ouvrées pour convenir d’une visite et d’un métré à domicile."
    crumbs={[{ label: 'Demande de devis' }]}
    compact
  />

  <section class="section">
    <div class="container dgrid">
      <div class="dcard reveal">
        <DevisForm />
      </div>
      <aside class="daside">
        <div class="dwhy reveal" style="--d:100ms">
          <Rays class="dwhy__rays" />
          <h2 class="dwhy__title">Ce qui se passe ensuite</h2>
          <ol class="dwhy__list">
            <li><strong>On vous rappelle</strong><span>sous 48 h ouvrées pour comprendre le projet et fixer un rendez-vous.</span></li>
            <li><strong>On vient mesurer</strong><span>chez vous, gratuitement, ou on vous reçoit en showroom.</span></li>
            <li><strong>Vous recevez le devis</strong><span>détaillé, avec les aides mobilisables et un délai de pose.</span></li>
          </ol>
        </div>
        <div class="dcontact reveal" style="--d:180ms">
          <h2 class="dcontact__title">Vous préférez appeler ?</h2>
          {
            agencesList.map((a) => (
              <a class="dcontact__agence" href={`tel:${a.tel}`}>
                <span class="tag">Agence de {a.city}</span>
                <strong>
                  <Icon id="phone" /> {a.phone}
                </strong>
                <small>{a.hours[0].days} : {a.hours[0].time}</small>
              </a>
            ))
          }
        </div>
        <TrustStrip ids={['rge', 'meo', 'janneau', 'horizal']} />
      </aside>
    </div>
  </section>
</Base>

<style>
  .dgrid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .dcard {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: var(--radius-l);
    background: var(--white);
    border: 1px solid var(--stone-200);
    box-shadow: var(--shadow-s);
  }
  .daside {
    display: grid;
    gap: 1.25rem;
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }
  .dwhy {
    position: relative;
    overflow: hidden;
    padding: 1.6rem;
    border-radius: var(--radius);
    background: var(--green-900);
    color: var(--white);
  }
  .dwhy__rays {
    position: absolute;
    right: -15%;
    bottom: -25%;
    width: 55%;
    color: var(--lime);
    opacity: 0.16;
  }
  .dwhy__title {
    position: relative;
    color: var(--white);
    font-size: 1.7rem;
    margin-bottom: 1rem;
  }
  .dwhy__list {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.9rem;
    counter-reset: n;
  }
  .dwhy__list li {
    counter-increment: n;
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 0.1rem 0.6rem;
  }
  .dwhy__list li::before {
    content: counter(n);
    grid-row: span 2;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--lime);
    color: var(--green-950);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .dwhy__list strong {
    font-family: var(--font-ui);
    font-weight: 600;
  }
  .dwhy__list span {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.75);
  }
  .dcontact {
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--stone-50);
    border: 1px solid var(--stone-200);
    display: grid;
    gap: 0.9rem;
  }
  .dcontact__title {
    font-size: 1.5rem;
    margin: 0;
  }
  .dcontact__agence {
    display: grid;
    gap: 0.15rem;
    text-decoration: none;
    color: var(--ink);
    padding-top: 0.75rem;
    border-top: 1px solid var(--stone-200);
  }
  .dcontact__agence strong {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--green-900);
  }
  .dcontact__agence small {
    color: var(--ink-3);
  }
  @media (max-width: 900px) {
    .dgrid {
      grid-template-columns: 1fr;
    }
    .daside {
      position: static;
    }
  }
</style>
