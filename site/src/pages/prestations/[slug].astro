---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import Icon from '../../components/Icon.astro';
import Rays from '../../components/Rays.astro';
import RealisationCard from '../../components/RealisationCard.astro';
import PrestationCard from '../../components/PrestationCard.astro';
import Faq from '../../components/Faq.astro';
import Placeholder from '../../components/Placeholder.astro';
import LocalCta from '../../components/LocalCta.astro';
import CtaBand from '../../components/CtaBand.astro';
import { prestationsPubliees, type Prestation } from '../../data/prestations';
import { realisationsByPrestation } from '../../data/realisations';
import { marqueBySlug } from '../../data/marques';
import { croiseeBySlug } from '../../data/croisees';
import { site } from '../../data/site';
import { realPhoto, equipePhoto } from '../../data/photos';

export function getStaticPaths() {
  return prestationsPubliees.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Prestation };

const hero = 'real' in p.hero ? realPhoto(p.hero.real, p.hero.i ?? 1) : 'equipe' in p.hero ? equipePhoto(p.hero.equipe) : undefined;
const placeholderId = 'gen' in p.hero ? p.hero.gen : undefined;
const reals = realisationsByPrestation(p.slug).sort((a, b) => Number(!!b.featured) - Number(!!a.featured)).slice(0, 3);
const marques = p.marques.map(marqueBySlug).filter(Boolean);
const croisee = p.croisee ? croiseeBySlug(p.croisee) : undefined;
const others = prestationsPubliees.filter((x) => x.slug !== p.slug).slice(0, 3);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: p.h1,
    serviceType: p.title,
    description: p.metaDescription,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: [
      { '@type': 'AdministrativeArea', name: 'Charente-Maritime' },
      { '@type': 'City', name: 'Jonzac' },
      { '@type': 'City', name: 'Royan' },
      { '@type': 'City', name: 'Saintes' },
      { '@type': 'City', name: 'Cognac' },
    ],
    url: `${site.url}/prestations/${p.slug}/`,
    brand: marques.map((m) => ({ '@type': 'Brand', name: m!.name })),
  },
];
---

<Base title={p.metaTitle} description={p.metaDescription} jsonLd={jsonLd}>
  <PageHero
    title={p.h1}
    eyebrow="Prestation"
    lead={p.lead}
    crumbs={[{ label: 'Prestations', href: '/prestations/' }, { label: p.title }]}
    image={hero}
    imageAlt={p.title}
    placeholderId={placeholderId}
  >
    <div class="phero-ctas">
      <a class="btn btn--primary btn--lg" href="/devis/">Demander un devis <Icon id="arrow" /></a>
      <a class="btn btn--ghost" href="#realisations">Voir des réalisations</a>
    </div>
  </PageHero>

  <div class="container facts-wrap">
    <ul class="facts">
      {
        p.facts.map((f, i) => (
          <li class="reveal" style={`--d:${i * 70}ms`}>
            <span class="facts__label">{f.label}</span>
            <span class="facts__value">{f.value}</span>
          </li>
        ))
      }
    </ul>
  </div>

  {
    p.sections.map((s, si) => (
      <section class:list={['section', { 'section--stone pattern-rays': si % 2 === 1 }]}>
        <div class="container">
          <div class="txt-grid">
            <div>
              <SectionHead title={s.title} />
              {s.images && (
                <div class:list={['txt-media', 'reveal', 'reveal--scale', { 'txt-media--2': s.images.length > 1 }]}>
                  {s.images.map((id) => (
                    <Placeholder id={id} label={s.title} ratio={s.images!.length > 1 ? '1 / 1' : '4 / 3'} class="txt-media__item" />
                  ))}
                </div>
              )}
            </div>
            <div class="txt-body reveal">
              {s.text.map((t) => (
                <p>{t}</p>
              ))}
            </div>
          </div>
          {s.items && (
            <div class="grid grid--2 items">
              {s.items.map((it, i) => (
                <div class="item reveal" style={`--d:${(i % 2) * 80}ms`}>
                  <span class="item__ic">
                    <Icon id="check" />
                  </span>
                  <div>
                    <h3>{it.title}</h3>
                    <p>{it.text}</p>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    ))
  }

  {
    p.gammes.length > 0 && (
      <section class="section section--green on-dark gammes">
        <Rays class="rays-giant rays-giant--bl" style="opacity:.08" />
        <div class="container">
          <SectionHead eyebrow="Gammes & fabricants" title={`Nos gammes de ${p.title.toLowerCase()}`} />
          <div class="grid grid--2">
            {p.gammes.map((g, i) => (
              <div class="gamme reveal" style={`--d:${(i % 2) * 80}ms`}>
                {g.marque && <span class="badge badge--dark">{g.marque}</span>}
                <h3>{g.title}</h3>
                <p>{g.text}</p>
              </div>
            ))}
          </div>
          {marques.length > 0 && (
            <p class="gammes__marques">
              {marques.map((m) => (
                <a class="gammes__marque" href={`/marques-partenaires/#${m!.slug}`}>
                  {m!.label ?? m!.name} <Icon id="arrow-up-right" />
                </a>
              ))}
            </p>
          )}
        </div>
      </section>
    )
  }

  {
    p.arguments.length > 0 && (
      <section class="section">
        <div class="container">
          <SectionHead eyebrow="Pourquoi LUZ" title={`Pourquoi confier vos ${p.title.toLowerCase()} à LUZ`} />
          <div class="grid grid--4">
            {p.arguments.map((a, i) => (
              <div class="arg reveal" style={`--d:${i * 70}ms`}>
                <Rays class="arg__rays" />
                <h3>{a.title}</h3>
                <p>{a.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    reals.length > 0 && (
      <section class="section section--stone pattern-rays" id="realisations">
        <div class="container">
          <SectionHead eyebrow="Réalisations" title={`${p.title} : nos chantiers`} row>
            <a class="link-arrow" href={`/realisations/?prestation=${p.slug}`}>
              Toutes les réalisations {p.nav.toLowerCase()} <Icon id="arrow" />
            </a>
          </SectionHead>
          <div class="grid grid--3">
            {reals.map((r, i) => (
              <RealisationCard real={r} delay={i * 70} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Près de chez vous" title={`Votre projet ${p.nav.toLowerCase()} à Jonzac ou à Royan`} />
      <LocalCta produit={p.nav.toLowerCase()} />
      {
        (croisee || p.aides) && (
          <div class="grid grid--2 mt-2">
            {croisee && (
              <a class="callout reveal" href={`/${croisee.slug}/`}>
                <span class="tag">Sur le littoral</span>
                <strong>{croisee.produit} à Royan</strong>
                <span>Conseils spécifiques au bord de mer, réalisations en pays royannais et agence de Breuillet.</span>
                <span class="link-arrow">
                  Lire la page <Icon id="arrow" />
                </span>
              </a>
            )}
            {p.aides && (
              <a class="callout callout--lime reveal" href="/aides-financement/" style="--d:80ms">
                <span class="tag">Aides & financement</span>
                <strong>MaPrimeRénov’, CEE, TVA 5,5 %, éco-PTZ</strong>
                <span>Entreprise RGE : nous montons le dossier d’aides avec vous, sous conditions d’éligibilité.</span>
                <span class="link-arrow">
                  Voir les aides <Icon id="arrow" />
                </span>
              </a>
            )}
          </div>
        )
      }
    </div>
  </section>

  {
    p.faq.length > 0 && (
      <section class="section section--stone">
        <div class="container container--narrow">
          <SectionHead eyebrow="Questions fréquentes" title={`${p.title} : vos questions`} center />
          <Faq items={p.faq} />
        </div>
      </section>
    )
  }

  <CtaBand title={`Un projet ${p.nav.toLowerCase()}&nbsp;? Parlons-en.`} />

  <section class="section section--tight">
    <div class="container">
      <SectionHead eyebrow="Autres prestations" title="Vous pourriez aussi avoir besoin de" row>
        <a class="link-arrow" href="/prestations/">Toutes les prestations <Icon id="arrow" /></a>
      </SectionHead>
      <div class="grid grid--3">
        {others.map((o, i) => <PrestationCard prestation={o} delay={i * 70} compact />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .phero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .facts-wrap {
    position: relative;
    z-index: 2;
  }
  .facts {
    list-style: none;
    padding: 0;
    margin: -3rem 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--white);
    border: 1px solid var(--stone-200);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .facts li {
    padding: 1.1rem 1.25rem;
    display: grid;
    gap: 0.2rem;
    border-right: 1px solid var(--stone-200);
  }
  .facts li:last-child {
    border-right: 0;
  }
  .facts__label {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green-500);
  }
  .facts__value {
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--green-900);
    line-height: 1.3;
  }
  @media (max-width: 860px) {
    .facts {
      grid-template-columns: 1fr 1fr;
      margin-top: 1.5rem;
      box-shadow: var(--shadow-s);
    }
    .facts li:nth-child(2n) {
      border-right: 0;
    }
    .facts li:nth-child(-n + 2) {
      border-bottom: 1px solid var(--stone-200);
    }
  }
  .txt-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 2rem 4rem;
    align-items: start;
  }
  .txt-grid :global(.section-head) {
    margin-bottom: 0;
  }
  .txt-body {
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--ink-2);
  }
  .txt-body p:last-child {
    margin-bottom: 0;
  }
  .txt-media {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.75rem;
  }
  .txt-media--2 {
    grid-template-columns: 1fr 1fr;
  }
  .txt-media :global(.txt-media__item) {
    border-radius: var(--radius);
    overflow: hidden;
  }
  @media (max-width: 800px) {
    .txt-grid {
      grid-template-columns: 1fr;
    }
  }
  .items {
    margin-top: 2.5rem;
  }
  .item {
    display: flex;
    gap: 1rem;
    padding: 1.4rem;
    background: var(--white);
    border: 1px solid var(--stone-200);
    border-radius: var(--radius);
  }
  .item__ic {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--lime-100);
    color: var(--green-800);
  }
  .item h3 {
    font-size: 1.1rem;
    margin-bottom: 0.35rem;
  }
  .item p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.97rem;
    line-height: 1.5;
  }
  .gammes {
    overflow: hidden;
  }
  .gamme {
    padding: 1.5rem;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .gamme h3 {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.7rem;
    margin: 0.2rem 0 0;
  }
  .gamme p {
    margin: 0;
    color: rgba(255, 255, 255, 0.8);
  }
  .gamme .badge {
    justify-self: start;
  }
  .gammes__marques {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 2rem 0 0;
  }
  .gammes__marque {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: var(--white);
    text-decoration: none;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.85rem;
  }
  .gammes__marque:hover {
    background: var(--lime);
    border-color: var(--lime);
    color: var(--green-950);
  }
  .arg {
    position: relative;
    overflow: hidden;
    padding: 1.5rem 1.4rem;
    border-radius: var(--radius);
    background: var(--stone-50);
    border: 1px solid var(--stone-200);
  }
  .arg__rays {
    position: absolute;
    right: -10%;
    top: -20%;
    width: 45%;
    color: var(--lime);
    opacity: 0.35;
    transform: rotate(180deg);
  }
  .arg h3 {
    position: relative;
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
  }
  .arg p {
    position: relative;
    margin: 0;
    color: var(--ink-2);
    font-size: 0.96rem;
    line-height: 1.5;
  }
  .callout {
    display: grid;
    gap: 0.4rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--green-900);
    color: var(--white);
    text-decoration: none;
    transition: transform 300ms var(--ease-out);
  }
  .callout:hover {
    transform: translateY(-3px);
    color: var(--white);
  }
  .callout .tag {
    color: var(--lime);
  }
  .callout strong {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.6rem;
    line-height: 1;
  }
  .callout > span:not(.tag):not(.link-arrow) {
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.97rem;
  }
  .callout .link-arrow {
    color: var(--lime);
    margin-top: 0.4rem;
  }
  .callout--lime {
    background: var(--lime-100);
    color: var(--ink);
  }
  .callout--lime:hover {
    color: var(--ink);
  }
  .callout--lime .tag,
  .callout--lime .link-arrow {
    color: var(--green-800);
  }
  .callout--lime strong {
    color: var(--green-900);
  }
  .callout--lime > span:not(.tag):not(.link-arrow) {
    color: var(--ink-2);
  }
</style>
