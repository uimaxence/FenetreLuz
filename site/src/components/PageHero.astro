---
/**
 * En-tête de page intérieure : photo plein cadre assombrie + fil d'Ariane + titre + chapô.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumb, { type Crumb } from './Breadcrumb.astro';
import Rays from './Rays.astro';
import Placeholder from './Placeholder.astro';

interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  crumbs: Crumb[];
  image?: ImageMetadata;
  imageAlt?: string;
  placeholderId?: string;
  compact?: boolean;
}
const { title, eyebrow, lead, crumbs, image, imageAlt = '', placeholderId, compact = false } = Astro.props;
---

<section class:list={['phero', 'on-dark', { 'phero--compact': compact, 'phero--plain': !image && !placeholderId }]}>
  {
    image ? (
      <Picture
        src={image}
        alt={imageAlt}
        widths={[640, 1024, 1600, 2000]}
        sizes="100vw"
        formats={['webp']}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="phero__img"
        pictureAttributes={{ class: 'phero__pic' }}
      />
    ) : placeholderId ? (
      <div class="phero__pic">
        <Placeholder id={placeholderId} ratio="auto" class="phero__ph" />
      </div>
    ) : null
  }
  <Rays class="phero__rays" animated />
  <div class="container phero__in">
    <Breadcrumb items={crumbs} light />
    {
      eyebrow && (
        <p class="eyebrow">
          <Rays /> {eyebrow}
        </p>
      )
    }
    <h1 set:html={title} />
    {lead && <p class="lead phero__lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .phero {
    position: relative;
    background: var(--green-900);
    overflow: hidden;
    isolation: isolate;
  }
  .phero :global(.phero__pic) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .phero :global(.phero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .phero :global(.phero__ph) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto !important;
  }
  .phero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, rgba(11, 46, 16, 0.92) 0%, rgba(21, 68, 24, 0.75) 45%, rgba(21, 68, 24, 0.35) 100%);
  }
  .phero--plain::before {
    background: linear-gradient(100deg, var(--green-950), var(--green-900));
  }
  .phero__rays {
    position: absolute;
    right: -6%;
    bottom: -10%;
    width: clamp(320px, 40vw, 620px);
    color: var(--lime);
    opacity: 0.14;
    pointer-events: none;
  }
  .phero__in {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 6rem);
    max-width: var(--container);
  }
  .phero--compact .phero__in {
    padding-block: clamp(2rem, 4vw, 3rem) clamp(2rem, 5vw, 3.5rem);
  }
  .phero .eyebrow {
    margin-top: 1.75rem;
  }
  .phero h1 {
    max-width: 18ch;
    margin-top: 0.5rem;
  }
  .phero :global(.crumbs) + h1 {
    margin-top: 1.75rem;
  }
  .phero__lead {
    max-width: 62ch;
    color: rgba(255, 255, 255, 0.85);
  }
</style>
