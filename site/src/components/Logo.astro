---
/**
 * Logo officiel LUZ (rayons + « LUZ » + baseline « Fenêtres & Vérandas »).
 * Source : src/assets/logos/logo luz.png fournie par Benoît (blanc sur fond transparent, 160 px),
 * recadrée en logo-luz.png. Le fichier est appliqué en masque CSS sur `currentColor`, ce qui donne
 * la version verte (header) et la version blanche (footer) à partir du même fichier, sans retouche.
 * Remplacer logo-luz.png par un export vectoriel (SVG) dès que Benoît le fournit : le composant n'a pas à changer.
 */
import logo from '../assets/logos/logo-luz.png';
interface Props {
  variant?: 'dark' | 'light';
  class?: string;
}
const { variant = 'dark', class: cls, ...rest } = Astro.props;
---

<span
  {...rest}
  class:list={['logo', `logo--${variant}`, cls]}
  role="img"
  aria-label="Fenêtres & Vérandas LUZ"
  style={`--logo-url:url(${logo.src});--logo-ratio:${logo.width} / ${logo.height}`}
></span>

<style>
  .logo {
    --logo-w: 64px;
    display: inline-block;
    width: var(--logo-w);
    aspect-ratio: var(--logo-ratio, 110 / 158);
    background-color: currentColor;
    -webkit-mask: var(--logo-url) center / contain no-repeat;
    mask: var(--logo-url) center / contain no-repeat;
    transition: width 400ms var(--ease-out);
  }
  .logo--dark {
    color: var(--green-500);
  }
  .logo--light {
    color: var(--white);
  }
  @media print {
    .logo--light {
      color: var(--green-500);
    }
  }
</style>
