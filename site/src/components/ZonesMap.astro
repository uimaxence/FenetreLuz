---
/**
 * Carte interactive des zones d'intervention (Charente-Maritime + Charente).
 * Données : src/data/zones-map.json, générées par scripts/build-zones-map.py (contours IGN via geo.api.gouv.fr,
 * zones approchées par intercommunalité d'après la carte cantonale de Benoît — à valider commune par commune).
 * Interaction : clic (ou clavier) sur une zone, un département ou un bouton de légende → panneau de détail ;
 * les repères de villes sont des liens vers les pages agences / villes quand elles existent.
 */
import Icon from './Icon.astro';
import map from '../data/zones-map.json';
import { agences, type Agence } from '../data/agences';

type ZoneId = 'jonzac' | 'royan' | 'dev';
type Commune = { n: string; d: string; p: number };
type City = { id: string; label: string; kind: 'agence' | 'ville' | 'town'; href: string | null; x: number; y: number; zone: string | null; dep: string };

const zones = map.zones as Record<ZoneId, { d: string; count: number; communes: Commune[] }>;
const deps = map.deps as Record<'17' | '16', { nom: string; d: string; communes: number; covered: number }>;
const cities = map.cities as City[];

/** Pages existantes pour certaines communes (lien sur la puce). */
const pageFor: Record<string, string> = {
  Jonzac: '/agences/jonzac/',
  'Saint-Germain-de-Lusignan': '/agences/jonzac/',
  Royan: '/agences/royan/',
  Breuillet: '/agences/royan/',
  Saintes: '/menuiserie-saintes/',
  Cognac: '/menuiserie-cognac/',
  "Saint-Pierre-d'Oléron": '/menuiserie-ile-oleron/',
  "Dolus-d'Oléron": '/menuiserie-ile-oleron/',
  "Le Château-d'Oléron": '/menuiserie-ile-oleron/',
};
const principales = (list: Commune[], n = 12) => [...list].sort((a, b) => b.p - a.p).slice(0, n);

const zoneMeta: Record<ZoneId, { kicker: string; title: string; text: string; agence: Agence[]; extra?: { label: string; href: string }[] }> = {
  jonzac: {
    kicker: 'Zone historique · Haute-Saintonge',
    title: 'Autour de Jonzac',
    text: `Notre agence historique et son showroom de 200 m² à Saint-Germain-de-Lusignan. ${zones.jonzac.count} communes de la Haute-Saintonge, de Pons à Montguyon et de Mirambeau à Archiac, desservies en moins de 30 minutes.`,
    agence: [agences.jonzac],
  },
  royan: {
    kicker: 'Zone littorale · Pays royannais, Marennes-Oléron',
    title: 'Royan, la Côte de Beauté et l’île d’Oléron',
    text: `Depuis Breuillet, à dix minutes de Royan : ${zones.royan.count} communes de la Côte de Beauté, de la presqu’île d’Arvert, du bassin de Marennes et de l’île d’Oléron. Menuiseries choisies pour le climat marin.`,
    agence: [agences.royan],
    extra: [
      { label: 'Menuiserie sur l’île d’Oléron', href: '/menuiserie-ile-oleron/' },
      { label: 'Véranda à Royan', href: '/veranda-royan/' },
      { label: 'Pergola à Royan', href: '/pergola-royan/' },
      { label: 'Portail à Royan', href: '/portail-royan/' },
    ],
  },
  dev: {
    kicker: 'Zone en développement · Saintonge & Charente',
    title: 'Saintes, Cognac et l’ouest de la Charente',
    text: `Depuis nos deux agences, nous posons jusqu’à Saintes, Saint-Porchaire, Gémozac, Cognac, Jarnac, Châteauneuf, Barbezieux et Rouillac : ${zones.dev.count} communes où le déplacement pour le métré et le devis reste gratuit.`,
    agence: [agences.jonzac, agences.royan],
    extra: [
      { label: 'Menuiserie à Saintes', href: '/menuiserie-saintes/' },
      { label: 'Menuiserie à Cognac', href: '/menuiserie-cognac/' },
    ],
  },
};
const zoneIds: ZoneId[] = ['jonzac', 'royan', 'dev'];
const zoneLabel: Record<ZoneId, string> = { jonzac: 'Zone historique (Jonzac)', royan: 'Zone littorale (Royan)', dev: 'Zone en développement' };

const depMeta = {
  '17': {
    kicker: 'Département',
    title: 'Charente-Maritime',
    text: `${deps['17'].covered} communes couvertes sur ${deps['17'].communes}, depuis nos agences de Jonzac et de Royan : toute la Haute-Saintonge, le pays royannais, Marennes-Oléron et la Saintonge de Saintes.`,
    agence: [agences.jonzac, agences.royan],
    communes: [...zones.jonzac.communes, ...zones.royan.communes, ...zones.dev.communes].filter((c) => c.d === '17'),
  },
  '16': {
    kicker: 'Département',
    title: 'Charente',
    text: `${deps['16'].covered} communes de l’ouest de la Charente, depuis l’agence de Jonzac : le pays de Cognac, Jarnac, Châteauneuf, Barbezieux et le Rouillacais. Mêmes équipes, mêmes fabricants, mêmes aides à la rénovation.`,
    agence: [agences.jonzac],
    communes: zones.dev.communes.filter((c) => c.d === '16'),
  },
};

const totalCommunes = zoneIds.reduce((n, z) => n + zones[z].count, 0);

/** Position des libellés (décalage en unités du viewBox) pour éviter les chevauchements. */
const labelPos: Record<string, { dx: number; dy: number; anchor?: 'start' | 'middle' | 'end' }> = {
  'agence-jonzac': { dx: 0, dy: -14, anchor: 'middle' },
  'agence-royan': { dx: 0, dy: -14, anchor: 'middle' },
  'la-tremblade': { dx: -9, dy: 4, anchor: 'end' },
  gemozac: { dx: -8, dy: 4, anchor: 'end' },
  jonzac: { dx: 9, dy: 13 },
  royan: { dx: 9, dy: 12 },
};
const pos = (c: City) => labelPos[c.id] ?? { dx: 9, dy: 4 };
const radius = { agence: 7.5, ville: 5.5, town: 3.5 } as const;

const panelList = (list: Commune[]) => [...list].sort((a, b) => a.n.localeCompare(b.n, 'fr'));
---

<div class="zmap" data-zone-map data-sel="all">
  <div class="zmap__map">
    <svg class="zmap__svg" viewBox={map.viewBox} role="group" aria-label="Carte des zones d’intervention de Fenêtres & Vérandas LUZ en Charente-Maritime et Charente">
      <g class="zmap__deps">
        {
          (['17', '16'] as const).map((d) => (
            <path class="dep" d={deps[d].d} data-dep={d} role="button" tabindex="0" aria-label={`${deps[d].nom} : ${deps[d].covered} communes couvertes`}>
              <title>{deps[d].nom}</title>
            </path>
          ))
        }
      </g>
      <g class="zmap__zones">
        {
          zoneIds.map((z) => (
            <path class:list={['zone', `zone--${z}`]} d={zones[z].d} data-zone={z} role="button" tabindex="0" aria-label={`${zoneLabel[z]} : ${zones[z].count} communes`}>
              <title>{zoneLabel[z]}</title>
            </path>
          ))
        }
      </g>
      <g class="zmap__cities">
        {
          cities.map((c) => {
            const p = pos(c);
            const inner = (
              <>
                <circle cx={c.x} cy={c.y} r={radius[c.kind]} />
                <text x={c.x + p.dx} y={c.y + p.dy} text-anchor={p.anchor ?? 'start'}>
                  {c.label}
                </text>
              </>
            );
            return c.href ? (
              <a class:list={['city', `city--${c.kind}`]} href={c.href} aria-label={`${c.label} — voir la page`}>
                {inner}
              </a>
            ) : (
              <g class:list={['city', `city--${c.kind}`]}>{inner}</g>
            );
          })
        }
      </g>
    </svg>

    <ul class="zmap__legend" aria-label="Légende">
      {
        zoneIds.map((z) => (
          <li>
            <button type="button" class:list={['zmap__key', `zmap__key--${z}`]} data-select={z} aria-pressed="false">
              <i /> {zoneLabel[z]} <small>{zones[z].count} communes</small>
            </button>
          </li>
        ))
      }
      <li class="zmap__legend-sep" aria-hidden="true"></li>
      {
        (['17', '16'] as const).map((d) => (
          <li>
            <button type="button" class="zmap__key zmap__key--dep" data-select={d} aria-pressed="false">
              <i /> {deps[d].nom} <small>{d}</small>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="zmap__panel" aria-live="polite">
    <button type="button" class="zmap__reset" data-select="all" hidden><Icon id="close" /> Revenir à la vue d’ensemble</button>
    <!-- Vue d'ensemble -->
    <div class="zpanel" data-panel="all">
      <p class="zpanel__kicker"><Icon id="map" /> Deux agences, trois zones</p>
      <h3 class="zpanel__title">{totalCommunes} communes desservies en Charente-Maritime et Charente</h3>
      <p class="zpanel__text">
        Sélectionnez votre secteur sur la carte : vous verrez l’agence qui vous suit, les communes desservies et nos pages locales.
      </p>
      <ul class="zpanel__zones">
        {
          zoneIds.map((z) => (
            <li>
              <button type="button" class="zpanel__zone" data-select={z}>
                <i class:list={['zpanel__dot', `zpanel__dot--${z}`]} />
                <span>
                  <strong>{zoneMeta[z].title}</strong>
                  <small>{zoneMeta[z].kicker}</small>
                </span>
                <Icon id="chevron-right" />
              </button>
            </li>
          ))
        }
      </ul>
      <div class="zpanel__agences">
        {
          [agences.jonzac, agences.royan].map((a) => (
            <a class="zpanel__agence zpanel__agence--mini" href={`/agences/${a.slug}/`}>
              <Icon id="pin" />
              <span>
                <strong>{a.name}</strong>
                <small>{a.address.city} · {a.phone}</small>
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <!-- Panneaux zones -->
    {
      zoneIds.map((z) => {
        const m = zoneMeta[z];
        const list = panelList(zones[z].communes);
        return (
          <div class="zpanel" data-panel={z} hidden>
            <p class="zpanel__kicker">
              <i class:list={['zpanel__dot', `zpanel__dot--${z}`]} /> {m.kicker}
            </p>
            <h3 class="zpanel__title">{m.title}</h3>
            <p class="zpanel__text">{m.text}</p>
            <div class="zpanel__agences">
              {m.agence.map((a) => (
                <div class="zpanel__agence">
                  <span class="zpanel__agence-ic">
                    <Icon id="home" />
                  </span>
                  <span>
                    <strong>{a.name}</strong>
                    <small>
                      {a.address.street}, {a.address.zip} {a.address.city}
                    </small>
                    <a class="zpanel__tel" href={`tel:${a.tel}`}>
                      <Icon id="phone" /> {a.phone}
                    </a>
                  </span>
                  <a class="btn btn--dark btn--sm" href={`/agences/${a.slug}/`}>
                    L’agence <Icon id="arrow" />
                  </a>
                </div>
              ))}
            </div>
            <p class="zpanel__label">Principales communes</p>
            <ul class="zpanel__chips">
              {principales(zones[z].communes).map((c) =>
                pageFor[c.n] ? (
                  <li>
                    <a href={pageFor[c.n]}>{c.n}</a>
                  </li>
                ) : (
                  <li>
                    <span>{c.n}</span>
                  </li>
                ),
              )}
            </ul>
            {m.extra && (
              <ul class="zpanel__links">
                {m.extra.map((l) => (
                  <li>
                    <a class="link-arrow" href={l.href}>
                      {l.label} <Icon id="arrow" />
                    </a>
                  </li>
                ))}
              </ul>
            )}
            <details class="zpanel__all">
              <summary>Toutes les communes de la zone ({zones[z].count})</summary>
              <ul>
                {list.map((c) => (
                  <li>{pageFor[c.n] ? <a href={pageFor[c.n]}>{c.n}</a> : c.n}</li>
                ))}
              </ul>
            </details>
            <a class="btn btn--primary zpanel__cta" href="/devis/">
              Demander un devis <Icon id="arrow" />
            </a>
          </div>
        );
      })
    }

    <!-- Panneaux départements -->
    {
      (['17', '16'] as const).map((d) => {
        const m = depMeta[d];
        return (
          <div class="zpanel" data-panel={d} hidden>
            <p class="zpanel__kicker">
              <Icon id="map" /> {m.kicker} {d}
            </p>
            <h3 class="zpanel__title">{m.title}</h3>
            <p class="zpanel__text">{m.text}</p>
            <div class="zpanel__agences">
              {m.agence.map((a) => (
                <a class="zpanel__agence zpanel__agence--mini" href={`/agences/${a.slug}/`}>
                  <Icon id="pin" />
                  <span>
                    <strong>{a.name}</strong>
                    <small>
                      {a.address.city} · {a.phone}
                    </small>
                  </span>
                </a>
              ))}
            </div>
            <p class="zpanel__label">Principales communes</p>
            <ul class="zpanel__chips">
              {principales(m.communes, 14).map((c) =>
                pageFor[c.n] ? (
                  <li>
                    <a href={pageFor[c.n]}>{c.n}</a>
                  </li>
                ) : (
                  <li>
                    <span>{c.n}</span>
                  </li>
                ),
              )}
            </ul>
            <p class="zpanel__hint">La liste complète des communes se trouve dans chaque zone (cliquez sur une couleur de la carte).</p>
            <a class="btn btn--primary zpanel__cta" href="/devis/">
              Demander un devis <Icon id="arrow" />
            </a>
          </div>
        );
      })
    }

  </div>
</div>

<script>
  function initZoneMaps() {
    document.querySelectorAll<HTMLElement>('[data-zone-map]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = '1';
      const panels = root.querySelectorAll<HTMLElement>('[data-panel]');
      const shapes = root.querySelectorAll<SVGElement>('[data-zone],[data-dep]');
      const buttons = root.querySelectorAll<HTMLButtonElement>('[data-select]');
      const reset = root.querySelector<HTMLButtonElement>('.zmap__reset');
      const panel = root.querySelector<HTMLElement>('.zmap__panel');
      let current = 'all';

      const select = (id: string, fromShape = false) => {
        current = id === current && fromShape ? 'all' : id;
        panels.forEach((p) => (p.hidden = p.dataset.panel !== current));
        shapes.forEach((s) => s.classList.toggle('is-active', (s.dataset.zone ?? s.dataset.dep) === current));
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.select === current)));
        root.dataset.sel = current;
        if (reset) reset.hidden = current === 'all';
        // Sur mobile, la carte est au-dessus du panneau : on amène le panneau dans la vue.
        if (panel && current !== 'all' && window.matchMedia('(max-width: 900px)').matches) {
          panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      };

      shapes.forEach((s) => {
        const id = (s.dataset.zone ?? s.dataset.dep)!;
        s.addEventListener('click', () => select(id, true));
        s.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            select(id, true);
          }
        });
        s.addEventListener('mouseenter', () => (root.dataset.hover = id));
        s.addEventListener('mouseleave', () => delete root.dataset.hover);
      });
      buttons.forEach((b) => b.addEventListener('click', () => select(b.dataset.select!)));
    });
  }
  document.addEventListener('astro:page-load', initZoneMaps);
</script>

<style>
  .zmap {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
  }
  .zmap__map {
    position: relative;
    background: var(--white);
    border: 1px solid var(--stone-200);
    border-radius: var(--radius-l);
    padding: clamp(0.75rem, 2vw, 1.5rem);
    box-shadow: var(--shadow-s);
  }
  .zmap__svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  /* Départements */
  .dep {
    fill: var(--stone-100);
    stroke: #c4cbba;
    stroke-width: 1.2;
    stroke-linejoin: round;
    cursor: pointer;
    outline: none;
    transition:
      fill 200ms ease,
      stroke 200ms ease;
  }
  .dep:hover,
  .dep:focus-visible {
    fill: var(--stone-200);
  }
  .dep.is-active {
    fill: var(--stone-200);
    stroke: var(--green-900);
    stroke-width: 2.2;
  }

  /* Zones */
  .zone {
    stroke: #fff;
    stroke-width: 1.6;
    stroke-linejoin: round;
    cursor: pointer;
    outline: none;
    transition:
      opacity 220ms ease,
      filter 220ms ease,
      stroke 220ms ease;
  }
  .zone--jonzac {
    fill: var(--green-500);
  }
  .zone--royan {
    fill: var(--green-800);
  }
  .zone--dev {
    fill: var(--lime);
  }
  .zone:hover,
  .zone:focus-visible {
    filter: brightness(1.1) saturate(1.1);
  }
  .zmap:not([data-sel='all']):not([data-sel='17']):not([data-sel='16']) .zone:not(.is-active) {
    opacity: 0.38;
  }
  .zone.is-active {
    stroke: var(--green-950);
    stroke-width: 2.6;
    filter: drop-shadow(0 6px 10px rgba(11, 46, 16, 0.25));
  }
  .zmap[data-sel='17'] .zone,
  .zmap[data-sel='16'] .zone {
    opacity: 0.9;
  }

  /* Villes */
  .city {
    pointer-events: none;
  }
  .city circle {
    fill: var(--green-950);
    stroke: #fff;
    stroke-width: 1.6;
    pointer-events: auto;
    transition: r 160ms ease;
  }
  .city text {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 12px;
    fill: var(--ink-2);
    paint-order: stroke;
    stroke: rgba(255, 255, 255, 0.9);
    stroke-width: 3px;
    stroke-linejoin: round;
    pointer-events: none; /* les libellés des simples repères laissent passer le clic vers la zone */
  }
  .city--ville text,
  .city--agence text {
    font-weight: 600;
    font-size: 13.5px;
    fill: var(--green-950);
  }
  .city--agence circle {
    fill: var(--orange);
    stroke-width: 2.4;
  }
  .city--agence text {
    fill: var(--orange-600);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 12.5px;
  }
  a.city {
    cursor: pointer;
    text-decoration: none;
  }
  a.city text {
    pointer-events: auto;
  }
  a.city:hover text,
  a.city:focus-visible text {
    fill: var(--orange);
    text-decoration: underline;
  }
  a.city:hover circle {
    r: 8;
  }

  /* Légende */
  .zmap__legend {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .zmap__legend-sep {
    width: 1px;
    height: 22px;
    background: var(--stone-200);
    margin-inline: 0.35rem;
  }
  .zmap__key {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.7rem 0.4rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--stone-200);
    background: var(--white);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--green-900);
    transition:
      background-color 160ms ease,
      border-color 160ms ease;
  }
  .zmap__key small {
    font-weight: 500;
    color: var(--ink-3);
  }
  .zmap__key i {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: var(--stone-200);
    border: 1px solid rgba(0, 0, 0, 0.08);
  }
  .zmap__key--jonzac i {
    background: var(--green-500);
  }
  .zmap__key--royan i {
    background: var(--green-800);
  }
  .zmap__key--dev i {
    background: var(--lime);
  }
  .zmap__key--dep i {
    background: var(--stone-100);
    border-color: #b7bfae;
  }
  .zmap__key:hover,
  .zmap__key[aria-pressed='true'] {
    background: var(--green-50);
    border-color: var(--green-500);
  }

  /* Panneau */
  .zmap__panel {
    position: relative;
    background: var(--white);
    border: 1px solid var(--stone-200);
    border-radius: var(--radius-l);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    box-shadow: var(--shadow-s);
    min-height: 100%;
  }
  .zpanel {
    display: grid;
    gap: 0.9rem;
    animation: zpanel-in 300ms var(--ease-out);
  }
  .zpanel[hidden],
  .zmap__reset[hidden] {
    display: none;
  }
  @keyframes zpanel-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .zpanel__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green-500);
  }
  .zpanel__kicker :global(svg) {
    color: var(--lime-600);
  }
  .zpanel__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--stone-200);
    flex: none;
  }
  .zpanel__dot--jonzac {
    background: var(--green-500);
  }
  .zpanel__dot--royan {
    background: var(--green-800);
  }
  .zpanel__dot--dev {
    background: var(--lime);
  }
  .zpanel__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.7rem, 2.4vw, 2.2rem);
    line-height: 0.98;
    color: var(--green-900);
  }
  .zpanel__text {
    margin: 0;
    color: var(--ink-2);
    line-height: 1.55;
  }
  .zpanel__zones {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
    display: grid;
    gap: 0.5rem;
  }
  .zpanel__zone {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.75rem 0.9rem;
