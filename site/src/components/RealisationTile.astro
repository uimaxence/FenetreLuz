---
/**
 * Tuile photo d'une réalisation (mur de chantiers) : la photo occupe toute la tuile,
 * le titre et la commune apparaissent sur un dégradé en bas. `big` = tuile 2×2 dans la grille.
 */
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { realisationBySlug } from '../data/realisations';
import { realPhoto } from '../data/photos';

interface Props {
  slug: string;
  i?: number; // numéro de la photo (1 = principale)
  big?: boolean;
  delay?: number;
}
const { slug, i = 1, big = false, delay = 0 } = Astro.props;
const r = realisationBySlug(slug);
const img = realPhoto(slug, i);
---

{
  r && img && (
    <a class:list={['tile', 'reveal', { 'tile--big': big }]} href={`/realisations/${r.slug}/`} style={`--d:${delay}ms`}>
      <Picture
        src={img}
        alt={`${r.title} — ${r.ville}`}
        widths={big ? [600, 900, 1400] : [400, 600, 900]}
        sizes={big ? '(max-width: 700px) 100vw, 50vw' : '(max-width: 700px) 50vw, 25vw'}
        formats={['webp']}
        loading="lazy"
        decoding="async"
        class="tile__img"
        pictureAttributes={{ class: 'tile__pic' }}
      />
      <span class="tile__body">
        <span class="tile__tag">{r.prestationLabel}</span>
        <strong class="tile__title">{r.title}</strong>
        <small class="tile__ville">
          <Icon id="pin" /> {r.ville}
        </small>
      </span>
    </a>
  )
}

<style>
  .tile {
    position: relative;
    display: block;
    aspect-ratio: 1;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--stone-100);
    text-decoration: none;
    color: var(--white);
    isolation: isolate;
  }
  .tile--big {
    grid-column: span 2;
    grid-row: span 2;
    aspect-ratio: auto;
  }
  .tile :global(.tile__pic) {
    position: absolute;
    inset: 0;
  }
  .tile :global(.tile__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(11, 46, 16, 0.85) 0%, rgba(11, 46, 16, 0.35) 38%, transparent 65%);
    transition: opacity 300ms ease;
  }
  .tile__body {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1rem 1.1rem 1rem;
    display: grid;
    gap: 0.2rem;
    transform: translateY(6px);
    transition: transform 400ms var(--ease-out);
  }
  .tile--big .tile__body {
    padding: 1.5rem 1.6rem 1.4rem;
  }
  .tile__tag {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lime);
  }
  .tile__title {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.98rem;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-wrap: balance;
  }
  .tile--big .tile__title {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.5rem, 2.4vw, 2.2rem);
    line-height: 0.98;
  }
  .tile__ville {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.8);
  }
  @media (hover: hover) and (pointer: fine) {
    .tile:hover :global(.tile__img) {
      transform: scale(1.06);
    }
    .tile:hover .tile__body {
      transform: none;
    }
    .tile:hover {
      color: var(--white);
    }
  }
  @media (max-width: 700px) {
    .tile__body {
      padding: 0.75rem 0.8rem;
    }
    .tile__title {
      font-size: 0.85rem;
    }
    .tile__ville {
      display: none;
    }
  }
</style>
