---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { agencesList } from '../data/agences';
import { prestationsMenu } from '../data/prestations';
import { villes } from '../data/villes';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const prestationsActive = path.startsWith('/prestations/') || path.startsWith('/depannage/');
const agencesActive =
  path.startsWith('/agences/') || path.startsWith('/menuiserie-') || path.startsWith('/contact/');
---

<a class="skip-link" href="#main">Aller au contenu</a>

<div class="topbar">
  <div class="container container--wide topbar__in">
    <ul class="topbar__agences">
      {
        agencesList.map((a) => (
          <li>
            <Icon id="pin" />
            <span class="topbar__city">{a.short}</span>
            <a href={`tel:${a.tel}`} class="topbar__tel">
              {a.phone}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="topbar__hours">
      <Icon id="clock" /> Lun.–ven. 9h–12h30 / 14h–18h15 · Sam. 9h–12h (Jonzac)
    </p>
    <ul class="topbar__social">
      <li>
        <a href={site.social.facebook} rel="noopener" target="_blank" aria-label="Facebook Fenêtres & Vérandas LUZ">
          <Icon id="facebook" />
        </a>
      </li>
      <li>
        <a href={site.social.instagram} rel="noopener" target="_blank" aria-label="Instagram Fenêtres & Vérandas LUZ">
          <Icon id="instagram" />
        </a>
      </li>
    </ul>
  </div>
</div>

<header class="header" id="header">
  <div class="container container--wide header__in">
    <a class="brand" href="/" aria-label="Fenêtres & Vérandas LUZ — Accueil">
      <Logo variant="dark" class="brand__logo" />
    </a>

    <nav class="nav" id="nav" aria-label="Navigation principale">
      <ul class="nav__list">
        <li class:list={['nav__item', 'has-mega', { 'is-active': prestationsActive }]}>
          <button class="nav__link" type="button" aria-expanded="false" aria-controls="mega-prestations">
            Prestations <Icon id="chevron" class="nav__chev" />
          </button>
          <div class="mega" id="mega-prestations">
            <div class="mega__in mega__in--prestations">
              <div class="mega__grid">
                {
                  prestationsMenu.map((p) => (
                    <a class="mega__item" href={`/prestations/${p.slug}/`}>
                      <span class="mega__icon">
                        <Icon id={p.icon} />
                      </span>
                      <span>
                        <strong>{p.title}</strong>
                        <small>{p.card}</small>
                      </span>
                    </a>
                  ))
                }
                <a class="mega__item mega__item--alt" href="/depannage/">
                  <span class="mega__icon">
                    <Icon id="depannage" />
                  </span>
                  <span>
                    <strong>Dépannage & entretien</strong>
                    <small>Volets, stores, portails, motorisations : intervention à domicile dès 121 € TTC.</small>
                  </span>
                </a>
              </div>
              <div class="mega__foot">
                <a class="link-arrow" href="/prestations/">Toutes nos prestations <Icon id="arrow" /></a>
                <a class="link-arrow" href="/realisations/">Voir les réalisations <Icon id="arrow" /></a>
              </div>
            </div>
          </div>
        </li>

        <li class:list={['nav__item', { 'is-active': isActive('/realisations/') }]}>
          <a class="nav__link" href="/realisations/" aria-current={isActive('/realisations/') ? 'page' : undefined}>Réalisations</a>
        </li>

        <li class:list={['nav__item', 'has-mega', { 'is-active': agencesActive }]}>
          <button class="nav__link" type="button" aria-expanded="false" aria-controls="mega-agences">
            Agences & zones <Icon id="chevron" class="nav__chev" />
          </button>
          <div class="mega" id="mega-agences">
            <div class="mega__in mega__in--agences">
              {
                agencesList.map((a) => (
                  <a class="mega__agence" href={`/agences/${a.slug}/`}>
                    <span class="tag">Agence & showroom</span>
                    <strong>Menuiserie à {a.city}</strong>
                    <span class="mega__addr">
                      {a.address.street}
                      <br />
                      {a.address.zip} {a.address.city}
                    </span>
                    <span class="mega__tel">
                      <Icon id="phone" /> {a.phone}
                    </span>
                    <span class="link-arrow">
                      Voir l’agence <Icon id="arrow" />
                    </span>
                  </a>
                ))
              }
              <div class="mega__zones">
                <span class="tag">Nous intervenons aussi à</span>
                <ul>
                  {
                    villes.map((v) => (
                      <li>
                        <a href={`/menuiserie-${v.slug}/`}>
                          <Icon id="chevron-right" /> Menuiserie à {v.name}
                        </a>
                      </li>
                    ))
                  }
                </ul>
                <a class="link-arrow" href="/contact/">Contact & horaires <Icon id="arrow" /></a>
              </div>
            </div>
          </div>
        </li>

        <li class:list={['nav__item', { 'is-active': isActive('/aides-financement/') }]}>
          <a class="nav__link" href="/aides-financement/" aria-current={isActive('/aides-financement/') ? 'page' : undefined}>Aides & financement</a>
        </li>
        <li class:list={['nav__item', { 'is-active': isActive('/conseils/') }]}>
          <a class="nav__link" href="/conseils/" aria-current={isActive('/conseils/') ? 'page' : undefined}>Conseils</a>
        </li>
        <li class:list={['nav__item', { 'is-active': isActive('/a-propos/') }]}>
          <a class="nav__link" href="/a-propos/" aria-current={isActive('/a-propos/') ? 'page' : undefined}>À propos</a>
        </li>
      </ul>

      <div class="nav__mobile-extra">
        <a class="btn btn--primary btn--block" href="/devis/">Demande de devis <Icon id="arrow" /></a>
        <a class="btn btn--ghost btn--block" href="/depannage/"><Icon id="depannage" /> Dépannage & entretien</a>
        <ul class="nav__mobile-contact">
          {
            agencesList.map((a) => (
              <li>
                <span>{a.short}</span>
                <a href={`tel:${a.tel}`}>
                  <Icon id="phone" /> {a.phone}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <div class="header__ctas">
      <a class="btn btn--outline header__cta-dep" href="/depannage/"><Icon id="depannage" /> Dépannage</a>
      <a class="btn btn--primary header__cta-devis" href="/devis/">Demande de devis <Icon id="arrow" /></a>
    </div>

    <button class="burger" type="button" aria-expanded="false" aria-controls="nav" aria-label="Ouvrir le menu">
      <span class="burger__box"><span class="burger__bar"></span></span>
    </button>
  </div>
</header>

<style>
  /* ---- Barre d'info ---- */
  .topbar {
    background: var(--green-950);
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .topbar__in {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 38px;
  }
  .topbar ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.25rem;
  }
  .topbar li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .topbar a {
    color: var(--white);
    text-decoration: none;
  }
  .topbar a:hover {
    color: var(--lime);
  }
  .topbar__city {
    color: var(--lime);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
  }
  .topbar__tel {
    font-weight: 600;
  }
  .topbar__hours {
    margin: 0 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: rgba(255, 255, 255, 0.7);
  }
  .topbar__social a {
    display: inline-flex;
    padding: 0.35rem;
    font-size: 1.05rem;
  }
  @media (max-width: 900px) {
    .topbar__hours {
      display: none;
    }
    .topbar__social {
      margin-left: auto;
    }
  }
  @media (max-width: 480px) {
    .topbar {
      font-size: 0.76rem;
    }
    .topbar__in {
      justify-content: center;
    }
    .topbar ul {
      gap: 0.9rem;
    }
    .topbar li {
      white-space: nowrap;
    }
    .topbar__city {
      font-size: 0.66rem;
    }
    .topbar__social {
      display: none;
    }
  }

  /* ---- Header ---- */
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: saturate(160%) blur(10px);
    -webkit-backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid var(--stone-200);
    transition: box-shadow 250ms ease;
  }
  .header.is-scrolled {
    box-shadow: 0 6px 24px -12px rgba(20, 40, 24, 0.25);
  }
  .header__in {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: var(--header-h);
    transition: height 250ms var(--ease-out);
  }
  .header.is-scrolled .header__in {
    height: var(--header-h-compact);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex: none;
    padding-block: 0.5rem;
  }
  .brand :global(.brand__logo) {
    --logo-w: 56px;
    transition: transform 400ms var(--ease-out);
  }
  .header.is-scrolled .brand :global(.brand__logo) {
    --logo-w: 46px;
  }
  @media (hover: hover) {
    .brand:hover :global(.logo__rays path) {
      animation: ray-in 700ms var(--ease-out) both;
    }
    .brand:hover :global(.logo__rays path:nth-child(1)) {
      animation-delay: 160ms;
    }
    .brand:hover :global(.logo__rays path:nth-child(2)),
    .brand:hover :global(.logo__rays path:nth-child(3)) {
      animation-delay: 80ms;
    }
  }

  /* ---- Nav desktop ---- */
  .nav {
    margin-left: auto;
  }
  .nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .nav__item {
    position: static;
  }
  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.6rem 0.8rem;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.92rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--green-900);
    text-decoration: none;
    border-radius: var(--radius-s);
    position: relative;
    white-space: nowrap;
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.25rem;
    height: 3px;
    border-radius: 2px;
    background: var(--lime);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 250ms var(--ease-out);
  }
  .nav__item:hover > .nav__link::after,
  .nav__item.is-active > .nav__link::after,
  .has-mega.open > .nav__link::after {
    transform: scaleX(1);
  }
  .nav__chev {
    font-size: 0.9em;
    transition: transform 250ms var(--ease-out);
  }
  .has-mega.open .nav__chev {
    transform: rotate(180deg);
  }

  /* ---- Méga-menus ---- */
  .mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--white);
    border-top: 1px solid var(--stone-200);
    box-shadow: 0 30px 50px -30px rgba(20, 40, 24, 0.35);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition:
      opacity 200ms var(--ease-out),
      transform 220ms var(--ease-out),
      visibility 0s linear 220ms;
  }
  .has-mega.open .mega {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .mega__in {
    width: min(100% - 2 * var(--gutter), var(--container-wide));
    margin-inline: auto;
    padding: 1.75rem 0 1.5rem;
  }
  .mega__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.35rem 1rem;
  }
  .mega__item {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    padding: 0.7rem 0.75rem;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
    transition: background-color 160ms ease;
  }
  .mega__item:hover {
    background: var(--stone-50);
    color: var(--ink);
  }
  .mega__item strong {
    display: block;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--green-900);
    line-height: 1.2;
    margin-bottom: 0.2rem;
  }
  .mega__item small {
    display: block;
    font-size: 0.84rem;
    line-height: 1.35;
    color: var(--ink-2);
  }
  .mega__icon {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius);
    background: var(--green-50);
    color: var(--green-700);
    font-size: 1.3rem;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }
  .mega__item:hover .mega__icon {
    background: var(--green-900);
    color: var(--lime);
  }
  .mega__item--alt .mega__icon {
    background: var(--lime-100);
  }
  .mega__foot {
    display: flex;
    gap: 2rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--stone-200);
  }
  .mega__in--agences {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1.5rem;
  }
  .mega__agence {
    display: grid;
    gap: 0.35rem;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--stone-50);
    text-decoration: none;
    color: var(--ink);
    transition: background-color 160ms ease;
  }
  .mega__agence:hover {
    background: var(--green-50);
    color: var(--ink);
  }
  .mega__agence strong {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--green-900);
  }
  .mega__addr {
    font-size: 0.92rem;
    color: var(--ink-2);
    line-height: 1.35;
  }
  .mega__tel {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--green-800);
  }
  .mega__agence .link-arrow {
    margin-top: 0.4rem;
    font-size: 0.85rem;
  }
  .mega__zones {
    padding: 1.25rem 0.5rem;
  }
  .mega__zones ul {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 1rem;
  }
  .mega__zones li a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0;
    text-decoration: none;
    font-weight: 600;
    color: var(--green-900);
  }
  .mega__zones li a:hover {
    color: var(--green-500);
  }

  /* ---- CTAs ---- */
  .header__ctas {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: none;
  }

  /* ---- Burger ---- */
  .burger {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-s);
    color: var(--green-900);
  }
  .burger__box {
    position: relative;
    width: 24px;
    height: 18px;
    display: block;
  }
  .burger__bar,
  .burger__bar::before,
  .burger__bar::after {
    content: '';
    position: absolute;
    left: 0;
    width: 24px;
    height: 2.5px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 250ms var(--ease-out),
      top 250ms var(--ease-out),
      opacity 200ms ease;
  }
  .burger__bar {
    top: 8px;
  }
  .burger__bar::before {
    top: -8px;
  }
  .burger__bar::after {
    top: 8px;
  }
  .burger[aria-expanded='true'] .burger__bar {
    transform: rotate(45deg);
  }
  .burger[aria-expanded='true'] .burger__bar::before {
    top: 0;
    transform: rotate(90deg);
  }
  .burger[aria-expanded='true'] .burger__bar::after {
    top: 0;
    opacity: 0;
  }

  .nav__mobile-extra {
    display: none;
  }

  /* ---- Mobile / tablette ---- */
  @media (max-width: 1180px) {
    .nav__link {
      padding-inline: 0.55rem;
      font-size: 0.85rem;
    }
    .header__cta-dep {
      display: none;
    }
  }
  @media (max-width: 1024px) {
    .header__in,
    .header.is-scrolled .header__in {
      height: 84px;
    }
    .brand :global(.brand__logo),
    .header.is-scrolled .brand :global(.brand__logo) {
      --logo-w: 50px;
    }
    .burger {
      display: inline-flex;
    }
    .header__cta-devis {
      padding: 0.75rem 1rem;
      font-size: 0.82rem;
    }
    .header__ctas {
      margin-left: auto;
    }
    .nav {
      position: fixed;
      inset: var(--header-h) 0 0 0;
      margin: 0;
      background: var(--green-900);
      color: var(--white);
      overflow-y: auto;
      padding: 1rem var(--gutter) 3rem;
      transform: translateX(100%);
      visibility: hidden;
      transition:
        transform 320ms var(--ease-out),
        visibility 0s linear 320ms;
    }
    :global(body.nav-open) .nav {
      transform: none;
      visibility: visible;
      transition-delay: 0s;
    }
    :global(body.nav-open) {
      overflow: hidden;
    }
    .nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .nav__item {
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }
    .nav__link {
      width: 100%;
      justify-content: space-between;
      padding: 1rem 0.25rem;
      font-size: 1.1rem;
      color: var(--white);
    }
    .nav__link::after {
      display: none;
    }
    .nav__item.is-active > .nav__link {
      color: var(--lime);
    }
    .mega {
      position: static;
      background: transparent;
      border: 0;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
      display: none;
      transition: none;
    }
    .has-mega.open .mega {
      display: block;
    }
    .mega__in {
      width: auto;
      padding: 0 0 1rem;
    }
    .mega__grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .mega__item {
      padding: 0.6rem 0.25rem;
      color: var(--white);
    }
    .mega__item:hover {
      background: rgba(255, 255, 255, 0.06);
      color: var(--white);
    }
    .mega__item strong {
      color: var(--white);
    }
    .mega__item small {
      color: rgba(255, 255, 255, 0.65);
    }
    .mega__icon {
      background: rgba(255, 255, 255, 0.1);
      color: var(--lime);
    }
    .mega__foot {
      border-color: rgba(255, 255, 255, 0.12);
      flex-direction: column;
      gap: 0.75rem;
    }
    .mega__foot .link-arrow,
    .mega__zones .link-arrow {
      color: var(--lime);
    }
    .mega__in--agences {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .mega__agence {
      background: rgba(255, 255, 255, 0.07);
      color: var(--white);
    }
    .mega__agence:hover {
      background: rgba(255, 255, 255, 0.1);
      color: var(--white);
    }
    .mega__agence strong {
      color: var(--white);
    }
    .mega__addr {
      color: rgba(255, 255, 255, 0.7);
    }
    .mega__tel {
      color: var(--lime);
    }
    .mega__agence .link-arrow {
      color: var(--lime);
    }
    .mega__zones {
      padding: 0.5rem 0.25rem;
    }
    .mega__zones li a {
      color: var(--white);
    }
    .nav__mobile-extra {
      display: grid;
      gap: 0.75rem;
      margin-top: 1.5rem;
    }
    .nav__mobile-contact {
      list-style: none;
      padding: 0;
      margin: 0.5rem 0 0;
      display: grid;
      gap: 0.5rem;
    }
    .nav__mobile-contact li {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-ui);
      font-weight: 600;
    }
    .nav__mobile-contact span {
      color: var(--lime);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 0.8rem;
    }
    .nav__mobile-contact a {
      color: var(--white);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 1.05rem;
    }
  }
  @media (max-width: 480px) {
    .header__cta-devis {
      padding: 0.7rem 0.8rem;
    }
    .header__cta-devis :global(svg) {
      display: none;
    }
  }
</style>
