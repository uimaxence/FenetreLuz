  leaf: '<path d="M4 20C6 12 11 6 20 4c-1 9-6 14-14 16"/><path d="M4 20c4-5 8-8 12-10"/>',
  handshake: '<path d="m3 9 4-3 5 2 5-2 4 3-2 7-4 3-3-2-3 2-4-3Z"/><path d="m12 8-3 3 2 2 3-2"/>',
  spark: '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/>',
};

const path = icons[id] ?? icons.spark;
const px = size ? `${size}px` : undefined;
---

<svg
  {...rest}
  class:list={['icon', cls]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  width={px}
  height={px}
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
  focusable="false"
  set:html={(title ? `<title>${title}</title>` : '') + path}
/>

<style>
  .icon {
    display: inline-block;
    width: 1em;
    height: 1em;
    flex: none;
    vertical-align: -0.15em;
  }
</style>
