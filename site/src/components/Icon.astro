  moteur: '<circle cx="12" cy="12" r="8"/><path d="M13 7.5 9.5 12.5h4L10.5 17"/>',
  brasero: '<path d="M4 15h16l-1.5 4h-13Z"/><path d="M7 19v2M17 19v2"/><path d="M12 3c-1 2.5-3.5 3.5-3.5 6.2a3.5 3.5 0 0 0 7 0c0-1.5-.6-2.5-1.3-3.4-.3 1-.8 1.4-1.2 1.6C13.2 6 12.8 4.5 12 3Z"/>',
