---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';
import type { Prestation } from '../data/prestations';
import { realPhoto } from '../data/photos';

interface Props {
  prestation: Prestation;
  delay?: number;
  compact?: boolean;
}
const { prestation: p, delay = 0, compact = false } = Astro.props;
const img = 'real' in p.hero ? realPhoto(p.hero.real, p.hero.i ?? 1) : undefined;
---

<a class:list={['pcard', 'reveal', { 'pcard--compact': compact }]} href={`/prestations/${p.slug}/`} style={`--d:${delay}ms`}>
  <div class="pcard__media">
    {
      img ? (
        <Picture src={img} alt="" widths={[420, 640, 900]} sizes="(max-width: 640px) 92vw, (max-width: 1100px) 46vw, 30vw" formats={['webp']} loading="lazy" decoding="async" class="pcard__img" />
      ) : (
        <Placeholder id={'gen' in p.hero ? p.hero.gen : p.slug} ratio="4 / 3" />
      )
    }
    <span class="pcard__icon"><Icon id={p.icon} /></span>
  </div>
  <div class="pcard__body">
    <h3 class="pcard__title">{p.title}</h3>
    {!compact && <p class="pcard__text">{p.card}</p>}
    <span class="pcard__more">Découvrir <Icon id="arrow" /></span>
  </div>
</a>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--stone-200);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    box-shadow: var(--shadow-s);
    transition:
      transform 300ms var(--ease-out),
      box-shadow 300ms var(--ease-out),
      border-color 200ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .pcard:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow);
      border-color: var(--green-100);
      color: var(--ink);
    }
    .pcard:hover :global(.pcard__img) {
      transform: scale(1.05);
    }
    .pcard:hover .pcard__more :global(svg) {
      transform: translateX(4px);
    }
    .pcard:hover .pcard__icon {
      background: var(--lime);
      color: var(--green-950);
    }
  }
  .pcard:active {
    transform: translateY(-2px) scale(0.99);
  }
  .pcard__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--stone-100);
  }
  .pcard :global(.pcard__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }
  .pcard__icon {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: var(--radius);
    background: var(--green-900);
    color: var(--lime);
    font-size: 1.45rem;
    box-shadow: 0 6px 14px -6px rgba(0, 0, 0, 0.4);
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }
  .pcard__body {
    padding: 1.15rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }
  .pcard__title {
    margin: 0;
    font-size: 1.22rem;
  }
  .pcard__text {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.97rem;
    line-height: 1.45;
    flex: 1;
  }
  .pcard__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.4rem;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--green-700);
  }
  .pcard__more :global(svg) {
    transition: transform 250ms var(--ease-out);
  }
  .pcard--compact .pcard__media {
    aspect-ratio: 16 / 10;
  }
  .pcard--compact .pcard__title {
    font-size: 1.1rem;
  }
</style>
