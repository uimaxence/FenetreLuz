# Copier en .env (jamais commité) et renseigner pour activer l'envoi des demandes de devis par e-mail.
# Sans configuration SMTP, la route /api/devis/ journalise la demande dans la console du serveur.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=contact@fenetresluz.com
SMTP_PASS=motdepasse
# Destinataire(s) des demandes, séparés par des virgules
DEVIS_TO=contact@fenetresluz.com
# Expéditeur affiché
DEVIS_FROM="Site fenetresluz.com <contact@fenetresluz.com>"
